# ── Credentials & secrets ─────────────────────────────
# Env files (any variant: .env, .env.local, .env.production, ...)
.env
.env.*
# Non-secret settings per environment are committed. NEXT_PUBLIC_* values end up in the browser bundle anyway.
!.env.development
!.env.production.example

# Keys, certificates and credential files
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
*credentials*.json
service-account*.json
secrets.*
*.secret
.npmrc
.vercel

# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Next.js build output ──────────────────────────────
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ── Tests ─────────────────────────────────────────────
coverage/

# ── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
