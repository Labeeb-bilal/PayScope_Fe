# Production settings. Set these in your host's environment settings (e.g. Vercel → Settings → Environment
# Variables), or copy this file to .env.production (ignored by git). Next.js reads them at BUILD time:
# after changing a value, redeploy.

# URL of the deployed backend, without a trailing slash. The backend's CORS_ORIGIN must list this site's URL.
# Leave empty when the backend serves this UI itself (same origin, single deployable).
NEXT_PUBLIC_API_URL=https://your-backend.example.com
